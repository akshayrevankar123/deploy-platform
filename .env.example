# Used by docker-compose. Copy to ".env" and fill in. NEVER commit ".env".
# Generate values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
# Shared secret the CI/CD pipeline uses to report deployment results. Leave empty to disable.
DEPLOY_REPORT_TOKEN=
